<div class="login-wrapper">
  <h2 class="ui center aligned icon header login-title">
    Live checklist
  </h2>
  <h4 class="ui center aligned medium icon header">
    <i class="circular orange tasks icon"></i>
    Log in to continue
  </h4>
  <div class="ui placeholder segment login-segment">
    <div class="ui two column very relaxed stackable grid">
      <div class="column">
        <%= form_for(:session, html: {class: "ui form", role: "form"}, url: login_path) do |f| %>
          <div class="field">
            <%= f.label :username, "Username" %>
            <div class="ui left icon input">
              <%= f.text_field :username, placeholder: "Username", autocomplete: "username" %>
              <i class="user icon"></i>
            </div>
          </div>
          <div class="field">
            <%= f.label :password, "Password" %>
            <div class="ui left icon input">
              <%= f.password_field :password, placeholder: "Password", autocomplete: "current-password" %>
              <i class="lock icon"></i>
            </div>
          </div>
          <%= f.button "Login", class: "ui fluid orange submit button" %>
        <% end %>
      </div>
      <div class="middle aligned center aligned column signup-column">
        <%= link_to signup_path, class: "ui big orange button" do %>
          <i class="signup icon"></i>
          Sign Up
        <% end %>
      </div>
    </div>
    <div class="ui vertical divider login-divider">Or</div>
  </div>
</div>
