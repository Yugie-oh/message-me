<% flash.each do |message_type, message_content| %>
  <% semantic_type = { "success" => "positive", "error" => "negative", "notice" => "info" }[message_type] || message_type %>
  <div class="ui <%= semantic_type %> message transition">
    <i class="close icon"></i>
    <div class="header">
      <%= message_content %>
    </div>
  </div>
<% end %>
