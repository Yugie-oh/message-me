<!DOCTYPE html>
<html>
  <head>
    <title>MessageMe</title>
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <%= favicon_link_tag %>
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= stylesheet_link_tag    'application', media: 'all', 'data-turbolinks-track': 'reload' %>
    <%= javascript_include_tag 'application', 'data-turbolinks-track': 'reload' %>
  </head>

  <body>
    <div class="ui small inverted menu">
      <div class="ui container">
        <%= render 'layouts/navigation' %>
      </div>
    </div>
    <div class="ui inverted vertical menu fluid mobile-nav-menu" id="mobile-nav-menu" style="display:none;">
      <%= link_to "Chatroom", root_path, class: "item" %>
      <a class="item">Messages</a>
      <%= link_to "Friends", friends_path, class: "item" %>
      <div class="ui divider"></div>
      <% if logged_in? %>
        <%= link_to "Log out", logout_path, method: :delete, class: "item" %>
      <% else %>
        <%= link_to "Log in", login_path, class: "item" %>
      <% end %>
    </div>
    <div class="ui container main-container">
      <%= render "layouts/messages" %>
      <%= yield %>
    </div>
  </body>
</html>
