<div id="item_<%= item.id %>" class="checklist-item <%= "is-done" if item.done %>" data-creator-id="<%= item.user_id %>" data-locked-by="<%= item.editing_by_id if item.locked? %>" data-locked-name="<%= item.editing_by.username if item.locked? && item.editing_by %>">
  <input type="checkbox" class="item-check" <%= "checked" if item.done %> data-toggle-item data-url="<%= checklist_item_path(item.checklist, item) %>" aria-label="Mark <%= item.body %> done">
  <div class="item-copy">
    <span class="item-body"><%= item.body %></span>
    <span class="item-meta">
      Added by <%= item.user.username %>
      <% if item.updated_by %>
        · Edited by <%= item.updated_by.username %>
      <% end %>
    </span>
  </div>
  <span class="item-lock"></span>
  <div class="item-actions">
    <button type="button" class="item-edit" data-edit-item data-lock-url="<%= lock_checklist_item_path(item.checklist, item) %>" data-unlock-url="<%= unlock_checklist_item_path(item.checklist, item) %>" data-save-url="<%= checklist_item_path(item.checklist, item) %>" aria-label="Edit <%= item.body %>">
      <i class="pencil alternate icon"></i>
    </button>
    <%= link_to checklist_item_path(item.checklist, item), method: :delete, remote: true,
          data: { confirm: "Remove this item?" },
          class: "item-delete", aria: { label: "Remove #{item.body}" } do %>
      <i class="trash alternate outline icon"></i>
    <% end %>
  </div>
</div>
