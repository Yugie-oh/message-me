<h4 class="ui center aligned medium icon header">
  <i class="circular orange users icon"></i>
  Friends
</h4>
<div class="ui stackable two column grid">
  <div class="twelve wide column">
    <div class="ui fluid raised card chatbox">
      <div class="content" id="messages">
        <% if @users.any? %>
          <div class="ui relaxed divided list">
            <% @users.each do |user| %>
              <div class="item">
                <i class="large user circle orange icon"></i>
                <div class="content">
                  <div class="header"><%= user.username %></div>
                  <div class="description">Member since <%= user.created_at.strftime("%B %Y") %></div>
                </div>
              </div>
            <% end %>
          </div>
        <% else %>
          <div class="ui info message">
            <div class="header">No other users yet.</div>
          </div>
        <% end %>
      </div>
    </div>
  </div>
  <div class="four wide column hide-on-mobile">
    <div class="ui fluid raised card chatbox">
      <div class="content">
        <div class="ui fluid inverted vertical menu">
          <%= link_to "Home", root_path, class: "item" %>
          <a class="item">Messages</a>
          <%= link_to "Friends", friends_path, class: "active item" %>
        </div>
      </div>
    </div>
  </div>
</div>
